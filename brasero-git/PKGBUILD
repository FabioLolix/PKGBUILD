pkgname=brasero-git
pkgver=3.12.4.r26.gc8c66bae
pkgrel=1
pkgdesc="CD/DVD mastering tool"
arch=(i686 x86_64)
url="https://wiki.gnome.org/Apps/Brasero"
license=(GPL-2.0-or-later)
groups=(gnome-extra)
depends=(
    cairo
    cdrdao
    cdrkit
    dconf
    dvd+rw-tools
    gdk-pixbuf2
    glib2
    glibc
    gsound
    gst-plugins-base-libs
    gst-plugins-good
    gstreamer
    gtk3
    gvfs
    hicolor-icon-theme
    #libcanberra
    libnotify
    #libsm
    libxml2
    pango
    #shared-mime-info
    totem-plparser
    tracker3
    )
makedepends=(
    #docbook-xsl
    git
    glib2-devel
    gnome-common
    #gobject-introspection
    gtk-doc
    #intltool
    #itstool
    libburn
    libisofs
    #libnautilus-extension
    meson
    yelp-tools
    )
optdepends=(
    'libburn: alternative back-end'
    'libisofs: libburn back-end'
    'dvdauthor: video project'
    'vcdimager: video project'
    )
provides=(brasero)
conflicts=(brasero)
#options=(!emptydirs)
source=("git+https://gitlab.gnome.org/GNOME/brasero.git")
sha256sums=('SKIP')

pkgver() {
  cd brasero
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  local meson_options=(
  )

  arch-meson brasero build "${meson_options[@]}"
  meson compile -C build
}

package() {
  meson install -C build --destdir "${pkgdir}"
}

